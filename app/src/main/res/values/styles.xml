<resources>

    <style name="Widget.Unef.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/on_ink</item>
    </style>

    <style name="Widget.Unef.Button.Small" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/hairline_strong</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Unef.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconPadding">10dp</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <style name="Widget.Unef.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Text.Unef.Title" parent="">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Unef.Section" parent="">
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Text.Unef.RowTitle" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Unef.RowSub" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Unef.Body" parent="">
        <item name="android:fontFamily">@font/figtree</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

</resources>
