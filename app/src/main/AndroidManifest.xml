<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used to read whether Private DNS pop-up blocking is active. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Needed so the app-risk scan can see every installed app and its
      requested permissions. Google Play restricts this permission, but this
      app is distributed as a direct download (sideload), not through Play.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnefCheckup">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
